<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.everydaylaws.video-prune</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/darylfung/.local/bin/lightsout</string>
    <string>--workspace</string>
    <string>/Users/darylfung/programming/LightsOut</string>
    <string>run</string>
    <string>video-prune</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/darylfung/programming/LightsOut</string>
  <!-- Before the midnight build: a full day's renders are old enough by then,
       and the build lock check in the job prevents pruning under a live render. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>23</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/darylfung/programming/LightsOut/logs/launchd-video-prune.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/darylfung/programming/LightsOut/logs/launchd-video-prune.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/darylfung/.local/bin</string>
    <key>HOME</key>
    <string>/Users/darylfung</string>
    <key>PRUNE_APPLY</key>
    <string>1</string>
  </dict>
</dict>
</plist>
