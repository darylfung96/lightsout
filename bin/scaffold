#!/usr/bin/env bash
# scaffold — turn a spec page into a job skeleton whose gates all fail closed.
# Contract: spec/SCHEMA.md (the parsing rules), docs/run-contract.md (the job).
#
#   scaffold <spec.md>
#
# Reads the nine fixed headings, takes the job name from `# spec: <name>`, and
# writes jobs/<name>/job.sh and jobs/<name>/spec.md. Every stage's gate is
# emitted as `u_gate never`: a generated gate would check what someone imagined,
# and `never` is the only honest gate nobody has written yet (docs/design.md).
# Exit 0 on a job written, 64 on misuse or an incomplete spec — and a refusal
# writes nothing at all, never half a job.
set -euo pipefail
REPO=$(cd "$(dirname "$0")/.." && pwd)

usage() {
  cat <<'TXT'
usage: scaffold <spec.md>

Turn a spec (spec/SCHEMA.md) into jobs/<name>/job.sh and jobs/<name>/spec.md.
The name comes from `# spec: <name>` in the spec. Every stage is emitted with
`u_gate never`, so the skeleton cannot pass until a human writes the real gate.

exit: 0 job written, 64 misuse or an incomplete spec (nothing is written)
TXT
}

fail() { printf 'scaffold: %s\n' "$*" >&2; exit 64; }

[ "$#" -le 1 ] || fail "one spec file at a time (got $# arguments)"
spec="${1:-}"
[ -n "$spec" ] || { usage >&2; exit 64; }
[ -f "$spec" ] || fail "no such spec: $spec"

parsed=$(mktemp "${TMPDIR:-/tmp}/lightsout-scaffold.XXXXXX") \
  || fail "cannot create a temporary file"
job_dir=""
created=0
trap 'rm -f "$parsed"; if [ "${created:-0}" = 1 ]; then rm -rf "$job_dir"; fi' EXIT

# One pass over the page. The protocol is tab-separated so the shell never has
# to eval anything a spec author wrote:
#   name<TAB><name>        heading<TAB><heading>
#   stage<TAB><n><TAB><label>
#   guard<TAB>lock         guard<TAB>disk<TAB><mb>
#   error<TAB><message>
# A heading is one of the nine fixed words (optionally after markdown #s). A
# stage starts at a numbered line in the stages block; every stage must carry
# `gate:` somewhere in its own lines. Labels are reduced to a safe alphabet
# before they are pasted into the generated job.
awk '
BEGIN {
  nw = split("deliverable cadence unit inputs stages guards publish memory budget", W, " ")
  for (i = 1; i <= nw; i++) want[W[i]] = 1
  cur = ""
  name = ""
  nstage = 0
  stage_gate = 0
  gtext = ""
}
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
function boom(msg) { printf "error\t%s\n", msg }
function end_stage() {
  if (nstage > 0 && stage_gate == 0) boom("stage " nstage " has no gate:")
}
{
  t = trim($0)
  if (name == "" && t ~ /^#[ \t]*spec:[ \t]*/) {
    name = t
    sub(/^#[ \t]*spec:[ \t]*/, "", name)
    name = trim(name)
    printf "name\t%s\n", name
    next
  }
  h = t
  sub(/^#+[ \t]*/, "", h)
  if (h in want && h !~ /[ \t]/) {
    if (cur == "stages") end_stage()
    cur = h
    seen[h] = 1
    printf "heading\t%s\n", h
    next
  }
  if (t == "") next
  if (cur == "stages") {
    if (t ~ /^:?[ \t]*[0-9]+[.)][ \t]/) {
      end_stage()
      nstage++
      stage_gate = 0
      label = t
      sub(/^:?[ \t]*[0-9]+[.)][ \t]*/, "", label)
      p = index(label, " \342\200\224 ")
      if (p > 0) label = substr(label, 1, p - 1)
      p = index(label, " - ")
      if (p > 0) label = substr(label, 1, p - 1)
      p = index(label, "gate:")
      if (p > 0) label = substr(label, 1, p - 1)
      label = trim(label)
      gsub(/[^A-Za-z0-9._ -]/, " ", label)
      gsub(/ +/, " ", label)
      label = trim(label)
      if (label == "") label = "stage " nstage
      printf "stage\t%d\t%s\n", nstage, label
    }
    if (index(t, "gate:") > 0) stage_gate = 1
  } else if (cur == "guards") {
    gtext = gtext " " t
  }
}
END {
  if (cur == "stages") end_stage()
  if (name == "") boom("no # spec: <name> line")
  for (i = 1; i <= nw; i++)
    if (!(W[i] in seen)) boom("missing heading: " W[i])
  if (nstage == 0) boom("no numbered stages under the stages heading")
  if (gtext ~ /(^|[ \t;])lock/ && gtext !~ /no[ \t]+lock/)
    printf "guard\tlock\n"
  if (match(gtext, /disk[ \t]+[0-9]+/)) {
    d = substr(gtext, RSTART, RLENGTH)
    gsub(/[^0-9]/, "", d)
    printf "guard\tdisk\t%s\n", d
  }
}' "$spec" > "$parsed" || fail "cannot parse $spec"

name=""
stages=""
errors=""
lock=0
disk=""
while IFS=$'\t' read -r kind a b; do
  case "$kind" in
    name)    name="$a" ;;
    stage)   stages="${stages}${a}	${b}"$'\n' ;;
    guard)
      case "$a" in
        lock) lock=1 ;;
        disk) disk="$b" ;;
      esac ;;
    error)   errors="${errors}${a}"$'\n' ;;
  esac
done < "$parsed"

if [ -n "$errors" ]; then
  while IFS= read -r e; do
    [ -n "$e" ] && printf 'scaffold: %s\n' "$e" >&2
  done <<< "$errors"
  exit 64
fi

[ -n "$name" ] || fail "the spec names no job"
# The name becomes a directory: refuse anything that is not a plain slug, so a
# spec can never write outside jobs/.
case "$name" in
  *[!a-z0-9-]*|[!a-z0-9]*)
    fail "spec name '$name' must be lowercase letters, digits and dashes" ;;
esac

job_dir="$REPO/jobs/$name"
if [ -e "$job_dir" ]; then
  fail "jobs/$name already exists; refusing to overwrite"
fi
mkdir -p "$REPO/jobs"
if ! mkdir "$job_dir" 2>/dev/null; then
  fail "jobs/$name already exists; refusing to overwrite"
fi
created=1

spec_label="${spec//$'\n'/ }"
job_sh="$job_dir/job.sh"
{
  printf '#!/usr/bin/env bash\n'
  printf '# jobs/%s/job.sh — scaffolded from %s by bin/scaffold.\n' "$name" "$spec_label"
  printf '#\n'
  printf '# Every stage is gated `never` on purpose: this job is a skeleton, and a\n'
  printf '# gate nobody has written may not pass (spec/SCHEMA.md). Replace one\n'
  printf '# `u_gate never` at a time with the check the spec names, then run\n'
  printf '# `bin/job plan %s` before scheduling it.\n' "$name"
  printf 'set -euo pipefail\n'
  printf '. "$REPO/lib/guards.sh"\n'
  printf '. "$REPO/lib/memory.sh"\n'
  printf '\n'
  printf 'u_guard_day\n'
  if [ "$lock" = 1 ]; then printf 'u_guard_lock\n'; fi
  printf 'u_guard_attempts\n'
  if [ -n "$disk" ]; then
    printf 'u_guard_disk %s\n' "$disk"
  else
    printf 'u_guard_disk\n'
  fi
  printf '\n'
  while IFS=$'\t' read -r n label; do
    [ -n "$n" ] || continue
    printf '# Stage %s — the gate is not written yet.\n' "$n"
    printf 'u_say "stage %s: %s — gate never (unimplemented)"\n' "$n" "$label"
    printf 'u_gate never\n'
    printf '\n'
  done <<< "$stages"
  printf 'u_say "stage: memory pass"\n'
  printf 'u_memory_pass || u_block "memory pass failed"\n'
  printf '\n'
  printf 'u_done\n'
  printf 'u_say "DONE"\n'
} > "$job_sh"

chmod +x "$job_sh"
cp "$spec" "$job_dir/spec.md"
created=0

printf 'scaffolded jobs/%s (%s stages, every gate never)\n' \
  "$name" "$(printf '%s' "$stages" | grep -c . || true)"
