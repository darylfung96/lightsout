#!/usr/bin/env bash
# job — plan | run | status | resume | unblock | list. Contract: docs/run-contract.md
set -euo pipefail
REPO=$(cd "$(dirname "$0")/.." && pwd)

usage() {
  cat <<'TXT'
usage: job <verb> [name]

  list                 jobs that exist
  status [name]        state from files; --json for machines
  plan <name>          what would run now; touches nothing
  run <name> [--class C] [--source S]
                       do the work, resuming from disk; C defaults every block
                       raised in this run (retryable|judgment|human)
  resume <name>        same as run
  unblock <name>       clear a blocked marker after a human looks

exit: 0 done or held, 1 failed, 2 blocked
TXT
}

# blocked_fields <file> — normalise state/blocked to iso<TAB>class<TAB>source<TAB>reason.
# Four fields is the current format; a two-field file from an older run reads as
# human with field 2 as the reason (docs/run-contract.md).
blocked_fields() {
  local raw iso cls src reason
  raw=$(cat "$1" 2>/dev/null || true)
  case "$raw" in
    *$'\t'*$'\t'*)
      IFS=$'\t' read -r iso cls src reason <<< "$raw"
      case "${cls:-}" in retryable|judgment|human) ;; *) cls=human ;; esac
      [ -n "${src:-}" ] || src=unknown
      [ -n "${reason:-}" ] || reason="no reason recorded" ;;
    *$'\t'*)
      iso=${raw%%$'\t'*}; cls=human; src=unknown; reason=${raw#*$'\t'} ;;
    *)
      iso=${raw:-unknown}; cls=human; src=unknown; reason="no reason recorded" ;;
  esac
  printf '%s\t%s\t%s\t%s' "${iso:-unknown}" "$cls" "$src" "$reason"
}

job_env() {
  JOB="$1"
  JOB_DIR="$REPO/jobs/$JOB"
  [ -f "$JOB_DIR/job.sh" ] || { echo "no such job: $JOB" >&2; exit 64; }
  STATE="$JOB_DIR/state"
  OUT="$JOB_DIR/out"
  mkdir -p "$STATE/attempts" "$STATE/done" "$OUT" "$JOB_DIR/logs" "$REPO/logs"
  LOG="$JOB_DIR/logs/$(date +%F).log"
  UNIT="${UNIT:-$(date +%F)}"
  U_ALERTS="$REPO/logs/alerts.log"
  DRY="${DRY:-0}"
  export REPO JOB JOB_DIR STATE OUT LOG UNIT U_ALERTS DRY
}

record() { # record <verb> <rc>
  local f="$STATE/last"
  { cat "$f" 2>/dev/null || true
    printf '%s\t%s\t%s\n' "$(date -Iseconds)" "$2" "$1"
  } | tail -50 > "$f.tmp"
  mv "$f.tmp" "$f"
}

run_job() { # run_job <name> <verb> <dry>
  job_env "$1"
  local verb="$2" dry="$3" rc=0
  U_BLOCK_CLASS="${U_BLOCK_CLASS:-human}"
  U_BLOCK_SOURCE="${U_BLOCK_SOURCE:-unknown}"
  export U_BLOCK_CLASS U_BLOCK_SOURCE
  if [ "$dry" = 0 ] && [ -f "$STATE/blocked" ]; then
    local fields iso cls src reason
    fields=$(blocked_fields "$STATE/blocked")
    IFS=$'\t' read -r iso cls src reason <<< "$fields"
    printf 'blocked since %s [%s]: %s\n' "$iso" "$cls" "$reason"
    if [ "$cls" = retryable ]; then
      printf '  run the allowlisted repair: bin/job retry %s\n' "$JOB"
    else
      printf '  fix the cause, then: bin/job unblock %s\n' "$JOB"
    fi
    exit 2
  fi
  DRY="$dry" bash "$JOB_DIR/job.sh" || rc=$?
  if [ "$dry" = 0 ]; then record "$verb" "$rc"; fi
  exit "$rc"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  list)
    for d in "$REPO"/jobs/*/; do
      [ -f "$d/job.sh" ] && basename "$d"
    done ;;

  status)
    exec python3 "$REPO/lib/report.py" "$@" ;;

  plan)
    [ -n "${1:-}" ] || { usage; exit 64; }
    run_job "$1" plan 1 ;;

  run|resume)
    [ -n "${1:-}" ] || { usage; exit 64; }
    name="$1"; shift
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --class)    [ "$#" -ge 2 ] || { echo "--class needs a value" >&2; exit 64; }
                    U_BLOCK_CLASS="$2"; shift 2 ;;
        --class=*)  U_BLOCK_CLASS="${1#*=}"; shift ;;
        --source)   [ "$#" -ge 2 ] || { echo "--source needs a value" >&2; exit 64; }
                    U_BLOCK_SOURCE="$2"; shift 2 ;;
        --source=*) U_BLOCK_SOURCE="${1#*=}"; shift ;;
        *) echo "unknown option: $1" >&2; usage; exit 64 ;;
      esac
    done
    case "${U_BLOCK_CLASS:-human}" in
      retryable|judgment|human) ;;
      *) echo "--class must be retryable, judgment or human" >&2; exit 64 ;;
    esac
    run_job "$name" "$cmd" 0 ;;

  unblock)
    [ -n "${1:-}" ] || { usage; exit 64; }
    job_env "$1"
    if [ -f "$STATE/blocked" ]; then
      printf '%s\tunblocked\t%s\n' "$(date -Iseconds)" "$(cat "$STATE/blocked")" >> "$U_ALERTS"
      rm -f "$STATE/blocked"
      echo "unblocked $JOB"
    else
      echo "$JOB was not blocked"
    fi ;;

  help|-h|--help) usage ;;
  *) usage; exit 64 ;;
esac
