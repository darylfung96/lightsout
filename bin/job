#!/usr/bin/env bash
# job — plan | run | status | check | diagnose | retry | resume | unblock | list.
# Contract: docs/run-contract.md
set -euo pipefail
REPO=$(cd "$(dirname "$0")/.." && pwd)

usage() {
  cat <<'TXT'
usage: job <verb> [name]

  list                 jobs that exist
  status [name]        state from files; --json for machines
  check [name]         alarm when an expected run never happened: notifies once
                       per job per day and exits 2 if a missed run is blocked
  plan <name>          what would run now; touches nothing
  diagnose <name>      read-only report on the current stop; writes
                       state/diagnosis.md and exits 0 even when blocked
  run <name> [--class C] [--source S]
                       do the work, resuming from disk; C defaults every block
                       raised in this run (retryable|judgment|human)
  retry <name> [--repair R]
                       run the allowlisted repair R (default touch-missing)
                       for a retryable block, then the job again so the same
                       gate decides; capped by MAX_REPAIRS (default 2)
  resume <name>        same as run
  unblock <name>       clear a blocked marker after a human looks

exit: 0 done or held, 1 failed, 2 blocked
TXT
}

# blocked_fields <file> — normalise state/blocked to iso<TAB>class<TAB>source<TAB>reason.
# Four fields is the current format; a two-field file from an older run reads as
# human with field 2 as the reason (docs/run-contract.md).
blocked_fields() {
  local raw iso cls src reason
  raw=$(cat "$1" 2>/dev/null || true)
  case "$raw" in
    *$'\t'*$'\t'*)
      IFS=$'\t' read -r iso cls src reason <<< "$raw"
      case "${cls:-}" in retryable|judgment|human) ;; *) cls=human ;; esac
      [ -n "${src:-}" ] || src=unknown
      [ -n "${reason:-}" ] || reason="no reason recorded" ;;
    *$'\t'*)
      iso=${raw%%$'\t'*}; cls=human; src=unknown; reason=${raw#*$'\t'} ;;
    *)
      iso=${raw:-unknown}; cls=human; src=unknown; reason="no reason recorded" ;;
  esac
  printf '%s\t%s\t%s\t%s' "${iso:-unknown}" "$cls" "$src" "$reason"
}

job_env() {
  JOB="$1"
  JOB_DIR="$REPO/jobs/$JOB"
  [ -f "$JOB_DIR/job.sh" ] || { echo "no such job: $JOB" >&2; exit 64; }
  STATE="$JOB_DIR/state"
  OUT="$JOB_DIR/out"
  mkdir -p "$STATE/attempts" "$STATE/done" "$OUT" "$JOB_DIR/logs" "$REPO/logs"
  LOG="$JOB_DIR/logs/$(date +%F).log"
  UNIT="${UNIT:-$(date +%F)}"
  U_ALERTS="$REPO/logs/alerts.log"
  DRY="${DRY:-0}"
  export REPO JOB JOB_DIR STATE OUT LOG UNIT U_ALERTS DRY
}

# diagnose_env — like job_env, but creates only state/, because the report is the
# one thing a diagnosis writes (docs/run-contract.md).
diagnose_env() {
  JOB="$1"
  JOB_DIR="$REPO/jobs/$JOB"
  [ -f "$JOB_DIR/job.sh" ] || { echo "no such job: $JOB" >&2; exit 64; }
  STATE="$JOB_DIR/state"
  OUT="$JOB_DIR/out"
  LOG="$JOB_DIR/logs/$(date +%F).log"
  UNIT="${UNIT:-$(date +%F)}"
  DRY=0
  mkdir -p "$STATE"
  export REPO JOB JOB_DIR STATE OUT LOG UNIT DRY
}

# retry_env — paths for retry, but creates nothing: a refused retry must touch
# nothing at all (docs/run-contract.md).
retry_env() {
  JOB="$1"
  JOB_DIR="$REPO/jobs/$JOB"
  [ -f "$JOB_DIR/job.sh" ] || { echo "no such job: $JOB" >&2; exit 64; }
  STATE="$JOB_DIR/state"
  OUT="$JOB_DIR/out"
  LOG="$JOB_DIR/logs/$(date +%F).log"
  UNIT="${UNIT:-$(date +%F)}"
  DRY=0
  U_ALERTS="$REPO/logs/alerts.log"
  export REPO JOB JOB_DIR STATE OUT LOG UNIT U_ALERTS DRY
}

# registered_repairs — the allowlist, read from the functions lib/repairs.sh
# defines. Nothing else can be named through `job retry`.
registered_repairs() {
  declare -F | awk '{print $3}' | sed -n 's/^repair_//p' | sort | tr '\n' ' ' \
    | sed 's/ *$//'
}

# record <verb> <rc> — one line per completed run. state/last keeps the last 50
# lines the stale check reads; state/runs.tsv is the same history with the
# duration, because a scheduler's tick is not the job's run. state/start is
# written by run_job before the job execs, so the seconds are the job's own and
# not the wrapper's. A missing start file (an older run, or a hand-written
# history) falls back to a zero-second run rather than a broken line.
record() { # record <verb> <rc>
  local verb="$1" rc="$2" f="$STATE/last" start="" start_epoch="" end end_epoch
  local seconds unit
  end=$(date -Iseconds)
  end_epoch=$(date +%s)
  if [ -f "$STATE/start" ]; then
    IFS=$'\t' read -r start start_epoch < "$STATE/start" || true
  fi
  case "${start_epoch:-}" in
    ''|*[!0-9]*) start_epoch=$end_epoch ;;
  esac
  [ -n "${start:-}" ] || start=$end
  seconds=$((end_epoch - start_epoch))
  [ "$seconds" -ge 0 ] || seconds=0
  # one line per run: a tab or newline in a field would corrupt the TSV
  unit="${UNIT:-unknown}"
  unit="${unit//$'\t'/ }"; unit="${unit//$'\n'/ }"
  { cat "$f" 2>/dev/null || true
    printf '%s\t%s\t%s\n' "$end" "$rc" "$verb"
  } | tail -50 > "$f.tmp"
  mv "$f.tmp" "$f"
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$start" "$end" "$rc" "$verb" "$unit" "$seconds" >> "$STATE/runs.tsv"
}

# --- stale-run check -----------------------------------------------------
# state/expect is one line, HH:MM local: the time a run is due. The alarm is
# built from files, because a job that never runs writes no log. report.py:stale
# makes the same test for status --json; keep the two in step.

expect_time() { # expect_time <state dir> — the HH:MM, or empty
  [ -f "$1/expect" ] || return 0
  sed -n '1p' "$1/expect" 2>/dev/null | tr -d '[:space:]'
}

# held_today <state dir> <date> — true when a run today ended rc 0. Only a run
# that reaches u_done writes done/<today>, so rc 0 with no done is a legitimate
# hold (the day guard after another unit, or the lock), never a missed run.
held_today() {
  [ -f "$1/last" ] || return 1
  awk -F'\t' -v day="$2" '
    index($1, day "T") == 1 && $2 == "0" { held = 1 }
    END { exit held ? 0 : 1 }' "$1/last"
}

# check_job <name> — 0 quiet, 2 when a missed run is also blocked. It never runs
# the job: an alarm that repaired would be a second runner.
check_job() {
  local name="$1" st="$REPO/jobs/$1/state" expect now today marker
  expect=$(expect_time "$st")
  [ -n "$expect" ] || return 0
  case "$expect" in
    [01][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9]) ;;
    *) printf 'check: %s: state/expect is not HH:MM: %s\n' "$name" "$expect" >&2
       return 0 ;;
  esac
  now=$(date +%H:%M)
  # zero-padded HH:MM compares as a clock
  if [[ "$now" < "$expect" ]]; then return 0; fi
  today=$(date +%F)
  [ -f "$st/done/$today" ] && return 0
  [ -d "$st/lock" ] && return 0
  # A blocked job is not stale — the block is the more specific stop and it
  # notified when it was raised — but a blocked job that missed its run keeps
  # the scheduler's non-zero state, which is how a persistent stop stays visible
  # without a notification every tick (docs/run-contract.md). This comes before
  # the hold test: an earlier hold today must not mask a later block.
  if [ -f "$st/blocked" ]; then
    printf 'blocked: %s missed its %s run\n' "$name" "$expect"
    return 2
  fi
  # A run that ended held did not miss; only a run that reaches u_done writes
  # done, so rc 0 today is the file evidence of the hold.
  held_today "$st" "$today" && return 0
  # One alarm per job per day: the marker is the memory of having raised it.
  marker="$st/alerts/$today.stale"
  if [ ! -f "$marker" ]; then
    mkdir -p "$st/alerts"
    printf '%s\t%s\n' "$(date -Iseconds)" "$expect" > "$marker"
    u_notify "LightsOut: $name stale" "no run by $expect today"
  fi
  printf 'stale: %s (expected %s)\n' "$name" "$expect"
  return 0
}

run_job() { # run_job <name> <verb> <dry>
  job_env "$1"
  local verb="$2" dry="$3" rc=0
  U_BLOCK_CLASS="${U_BLOCK_CLASS:-human}"
  U_BLOCK_SOURCE="${U_BLOCK_SOURCE:-unknown}"
  export U_BLOCK_CLASS U_BLOCK_SOURCE
  # Only a pass (u_done) or a human (unblock) clears state/blocked, so a retry
  # re-runs the job with the marker still in place; U_RETRYING is set by the
  # retry verb, and the job's own gates and guards decide the new verdict.
  if [ "$dry" = 0 ] && [ -f "$STATE/blocked" ] && [ "${U_RETRYING:-0}" != 1 ]; then
    local fields iso cls src reason
    fields=$(blocked_fields "$STATE/blocked")
    IFS=$'\t' read -r iso cls src reason <<< "$fields"
    printf 'blocked since %s [%s]: %s\n' "$iso" "$cls" "$reason"
    if [ "$cls" = retryable ]; then
      printf '  run the allowlisted repair: bin/job retry %s\n' "$JOB"
    else
      printf '  fix the cause, then: bin/job unblock %s\n' "$JOB"
    fi
    exit 2
  fi
  # The start line is the job's own clock: record() subtracts it after the job
  # returns, so a held, failed or blocked run gets its real duration. plan never
  # writes it, because plan touches nothing.
  if [ "$dry" = 0 ]; then
    printf '%s\t%s\n' "$(date -Iseconds)" "$(date +%s)" > "$STATE/start"
  fi
  DRY="$dry" bash "$JOB_DIR/job.sh" || rc=$?
  if [ "$dry" = 0 ]; then record "$verb" "$rc"; fi
  exit "$rc"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  list)
    for d in "$REPO"/jobs/*/; do
      [ -f "$d/job.sh" ] && basename "$d"
    done ;;

  status)
    exec python3 "$REPO/lib/report.py" "$@" ;;

  check)
    want="${1:-}"
    [ -z "$want" ] || [ -f "$REPO/jobs/$want/job.sh" ] || {
      echo "no such job: $want" >&2; exit 64; }
    mkdir -p "$REPO/logs"
    U_ALERTS="$REPO/logs/alerts.log"
    LOG="$REPO/logs/check.log"
    export U_ALERTS LOG
    . "$REPO/lib/guards.sh"   # u_notify: an alarm uses the same channels
    rc=0
    for d in "$REPO"/jobs/*/; do
      [ -f "$d/job.sh" ] || continue
      name=$(basename "$d")
      [ -z "$want" ] || [ "$name" = "$want" ] || continue
      r=0
      check_job "$name" || r=$?
      if [ "$r" = 2 ]; then rc=2; fi
    done
    exit "$rc" ;;

  plan)
    [ -n "${1:-}" ] || { usage; exit 64; }
    run_job "$1" plan 1 ;;

  diagnose)
    [ -n "${1:-}" ] || { usage; exit 64; }
    diagnose_env "$1"
    python3 "$REPO/lib/diagnose.py" "$JOB_DIR" \
      || { echo "diagnose failed for $JOB" >&2; exit 1; }
    cat "$STATE/diagnosis.md" ;;

  retry)
    [ -n "${1:-}" ] || { usage; exit 64; }
    name="$1"; shift
    repair="${NOOP_REPAIR:-touch-missing}"
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --repair)   [ "$#" -ge 2 ] || { echo "--repair needs a value" >&2; exit 64; }
                    repair="$2"; shift 2 ;;
        --repair=*) repair="${1#*=}"; shift ;;
        *) echo "unknown option: $1" >&2; usage; exit 64 ;;
      esac
    done
    retry_env "$name"
    if [ ! -f "$STATE/blocked" ]; then
      echo "$JOB is not blocked; nothing to retry"
      exit 0
    fi
    # The class is the permission to retry: retryable means an allowlisted
    # repair may clear the cause, anything else needs a human first.
    fields=$(blocked_fields "$STATE/blocked")
    IFS=$'\t' read -r iso cls src reason <<< "$fields"
    if [ "$cls" != retryable ]; then
      printf 'refusing to retry %s: class %s is not retryable\n' "$JOB" "$cls"
      printf '  the block is the record; read: bin/job diagnose %s\n' "$JOB"
      printf '  report: %s\n' "$STATE/diagnosis.md"
      exit 2
    fi
    [ -f "$REPO/lib/repairs.sh" ] || {
      echo "refusing to retry: no repair registry at lib/repairs.sh" >&2
      exit 2
    }
    . "$REPO/lib/repairs.sh"
    # The allowlist is the registry, so a name can never reach an arbitrary command.
    if ! declare -F "repair_$repair" >/dev/null 2>&1; then
      allowed=$(registered_repairs)
      printf 'refusing unknown repair: %s\n' "$repair"
      printf '  allowlisted: %s\n' "${allowed:-none}"
      exit 2
    fi
    max="${MAX_REPAIRS:-2}"
    case "$max" in
      ''|*[!0-9]*) echo "MAX_REPAIRS must be a whole number" >&2; exit 64 ;;
    esac
    count_file="$STATE/repairs/$(date +%F).count"
    n=0
    if [ -f "$count_file" ]; then
      n=$(tr -dc '0-9' < "$count_file")
      n="${n:-0}"
    fi
    if [ "$n" -ge "$max" ]; then
      printf 'repair cap reached (%s of %s today) for %s\n' "$n" "$max" "$JOB"
      printf '  the next repair needs a human: bin/job diagnose %s\n' "$JOB"
      exit 2
    fi
    mkdir -p "$STATE/repairs" "$JOB_DIR/logs"
    printf '%s\n' "$((n + 1))" > "$count_file"
    . "$REPO/lib/guards.sh"   # u_say: the retry lands in the job's own log
    u_say "retry: repair $repair ($((n + 1)) of $max today)"
    if "repair_$repair"; then
      u_say "retry: repair $repair done; rerunning $JOB so the gate decides"
    else
      u_say "retry: repair $repair failed; the block stands"
      exit 1
    fi
    # Re-run the whole job. The marker stays until u_done or unblock clears it,
    # so this is a re-check, not a verdict: every guard and gate runs again.
    U_RETRYING=1
    run_job "$name" retry 0 ;;

  run|resume)
    [ -n "${1:-}" ] || { usage; exit 64; }
    name="$1"; shift
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --class)    [ "$#" -ge 2 ] || { echo "--class needs a value" >&2; exit 64; }
                    U_BLOCK_CLASS="$2"; shift 2 ;;
        --class=*)  U_BLOCK_CLASS="${1#*=}"; shift ;;
        --source)   [ "$#" -ge 2 ] || { echo "--source needs a value" >&2; exit 64; }
                    U_BLOCK_SOURCE="$2"; shift 2 ;;
        --source=*) U_BLOCK_SOURCE="${1#*=}"; shift ;;
        *) echo "unknown option: $1" >&2; usage; exit 64 ;;
      esac
    done
    case "${U_BLOCK_CLASS:-human}" in
      retryable|judgment|human) ;;
      *) echo "--class must be retryable, judgment or human" >&2; exit 64 ;;
    esac
    run_job "$name" "$cmd" 0 ;;

  unblock)
    [ -n "${1:-}" ] || { usage; exit 64; }
    job_env "$1"
    if [ -f "$STATE/blocked" ]; then
      printf '%s\tunblocked\t%s\n' "$(date -Iseconds)" "$(cat "$STATE/blocked")" >> "$U_ALERTS"
      rm -f "$STATE/blocked"
      echo "unblocked $JOB"
    else
      echo "$JOB was not blocked"
    fi ;;

  help|-h|--help) usage ;;
  *) usage; exit 64 ;;
esac
