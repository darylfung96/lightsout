#!/usr/bin/env bash
# job — the compatibility launcher for the Rust manager.
#
# The manager itself is `lightsout`; this file only finds the built binary so
# the run contract's long-standing `bin/job <verb>` spelling keeps working.
set -euo pipefail
REPO=$(cd "$(dirname "$0")/.." && pwd)
export LIGHTSOUT_REPO="$REPO"
for bin in "$REPO/bin/lightsout" "$REPO/target/release/lightsout" "$REPO/target/debug/lightsout"; do
  if [ -x "$bin" ]; then
    exec "$bin" "$@"
  fi
done
echo "job: lightsout is not built; run: cargo build --release" >&2
exit 1
